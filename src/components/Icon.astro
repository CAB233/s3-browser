---
import type { Entry } from '../functions/s3.ts';
import { getIconDefinition } from '../functions/icon.ts';

interface Props {
  entry: Entry;
}
const icon = getIconDefinition(Astro.props.entry);
---

<svg
  xmlns="http://www.w3.org/2000/svg"
  class={icon.className}
  width="24"
  height="24"
  viewBox="0 0 24 24"
  stroke-width="2"
  stroke="currentColor"
  fill="none"
  stroke-linecap="round"
  stroke-linejoin="round"
>
  <use href={`#${icon.id}`} />
</svg>{' '}
