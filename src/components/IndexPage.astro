---
import Icon from './Icon.astro';

import { getIconDefinition, isImage } from '../functions/icon.ts';
import type { IconDefinition } from '../functions/icon.ts';
import UpArrow from '../icons/up-arrow.svg?raw';
import DownArrow from '../icons/down-arrow.svg?raw';
import Up from '../icons/up.svg?raw';
import CF from '../icons/cloudflare.svg?raw';
import Search from '../icons/search.svg?raw';
import List from '../icons/list.svg?raw';
import Grid from '../icons/grid.svg?raw';
import type { BreadcrumbEntry } from '../functions/breadcrumb.ts';
import type { FSListing } from '../functions/s3.ts';
import {
  buildSortUrl,
  paginateEntries,
  type ViewParams,
} from '../functions/sort.ts';

interface Props {
  breadCrums: BreadcrumbEntry[];
  requestPath: string;
  fsListing: FSListing;
  viewParams: ViewParams;
}

const { breadCrums, fsListing, requestPath, viewParams } = Astro.props;
const { layout, sort, order } = viewParams;
const urlPath = Astro.url.pathname;
const { entries } = paginateEntries(fsListing.entries, viewParams);
const iconDefinitions = new Map<string, IconDefinition>();
for (const entry of entries) {
  if (layout === 'grid' && isImage(entry)) continue;
  const icon = getIconDefinition(entry);
  iconDefinitions.set(icon.id, icon);
}
const dateTimeFormatter = new Intl.DateTimeFormat(undefined, {
  year: 'numeric',
  month: 'numeric',
  day: 'numeric',
  hour: 'numeric',
  minute: 'numeric',
  second: 'numeric',
});
const getSortIndicator = (field: string, currentSort: string, currentOrder: string): string =>
  field === currentSort ? (currentOrder === 'asc' ? UpArrow : DownArrow) : '';

// Build URLs for layout toggle
const listUrl = buildSortUrl(
  urlPath,
  viewParams,
  undefined,
  undefined,
  'list',
);
const gridUrl = buildSortUrl(
  urlPath,
  viewParams,
  undefined,
  undefined,
  'grid',
);

// Build URLs for sort headers
const nameSortUrl = buildSortUrl(urlPath, viewParams, 'name');
const directorySortUrl = buildSortUrl(urlPath, viewParams, 'namedirfirst');
const sizeSortUrl = buildSortUrl(urlPath, viewParams, 'size');
const timeSortUrl = buildSortUrl(urlPath, viewParams, 'time');

// Get sort indicators
const nameIndicator = getSortIndicator('name', sort, order);
const sizeIndicator = getSortIndicator('size', sort, order);
const timeIndicator = getSortIndicator('time', sort, order);
---

<header>
  <div class="wrapper">
    <div class="breadcrumbs">Folder Path</div>
    <h1>
      {breadCrums.map((crumb, index) => {
        return (
          (!!index && (
            <>
              <a href={crumb.path}>{crumb.name}</a>
              <span>/</span>
            </>
          )) || <a href={crumb.path}>{crumb.name}</a>
        );
      })}
    </h1>
  </div>
</header>

<div class:list={['wrapper', { 'grid-wrapper': layout === 'grid' }]}>
  <main data-view={layout}>
    <svg class="icon-definitions" xmlns="http://www.w3.org/2000/svg"
      width="0" height="0" aria-hidden="true" focusable="false">
      <defs>
        {Array.from(iconDefinitions.values()).map((icon) => (
          <symbol id={icon.id} viewBox="0 0 24 24">
            <Fragment set:html={icon.content} />
          </symbol>
        ))}
      </defs>
    </svg>
    <div class="meta">
      <div id="summary">
        <span class="meta-item">
          <b>{fsListing.numDirectories}</b>{' '}
          {fsListing.numDirectories === 1 ? 'directory' : 'directories'}
        </span>
        <span class="meta-item">
          <b>{fsListing.numFiles}</b>{' '}
          {fsListing.numFiles === 1 ? 'file' : 'files'}
        </span>
        <span class="meta-item">
          <b>{fsListing.numTotal}</b>{' '}total
        </span>
      </div>

        <a
          href={listUrl}
          class={`layout ${layout === 'list' ? 'current' : ''}`}
        >
          <Fragment set:html={List} />
          List
        </a>
        <a
          href={gridUrl}
          class={`layout ${layout === 'grid' ? 'current' : ''}`}
        >
          <Fragment set:html={Grid} />
          Grid
        </a>
    </div>

    {layout === 'list' ? (
      <div class="listing">
        <!-- List View -->
        <table aria-describedby="summary">
          <thead>
            <tr>
              <th></th>
              <th>
                <a href={directorySortUrl}
                  class:list={['icon', { sort: sort !== 'namedirfirst' }]}
                  aria-label="Sort names with directories first" title="Directories first">
                  <Fragment set:html={sort === 'namedirfirst' && order === 'desc' ? DownArrow : UpArrow} />
                </a>
                <a href={nameSortUrl} class="sort-header">Name<Fragment
                    set:html={nameIndicator}
                  /></a>
                <div class="filter-container">
                  <Fragment set:html={Search} />
                  <input type="search" placeholder="Search" id="filter"
                    aria-label="Filter files and directories" value={viewParams.filter} />
                </div>

              </th>
              <th>
                <a href={sizeSortUrl} class="sort-header">Size<Fragment
                    set:html={sizeIndicator}
                  /></a>
              </th>
              <th class="hideable">
                <a href={timeSortUrl} class="sort-header">Modified<Fragment
                    set:html={timeIndicator}
                  /></a>
              </th>
              <th class="hideable"></th>
            </tr>
          </thead>
          <tbody>
            {requestPath != '/' && (
              <tr>
                <td />
                <td>
                  <a href="..">
                    <Fragment set:html={Up} />
                    <span class="go-up">Up</span>
                  </a>
                </td>
                <td />
                <td class="hideable" />
                <td class="hideable" />
              </tr>
            )}
            {entries.map((entry) => {
              return (
                <tr class="file">
                  <td />
                  <td>
                    <a href={entry.anchor}>
                      <Icon {entry} />
                      <span class="name">{
                        entry.type === 'directory' ? `${entry.name}/` : entry.name
                      }</span>
                    </a>
                  </td>
                  {entry.size !== undefined ? (
                    <td class="size" data-size={entry.size}>
                      <div class="sizebar">
                        <div class="sizebar-bar" />
                        <div class="sizebar-text">
                          {entry.humanReadableSize}
                        </div>
                      </div>
                    </td>
                  ) : <td class="size">&mdash;</td>}
                  {(!!entry.lastModified && (
                    <td class="timestamp hideable">
                      <time datetime={entry.lastModified?.toISOString()}>
                        {dateTimeFormatter.format(entry.lastModified)}
                      </time>
                    </td>
                  )) || <td class="timestamp hideable">&mdash;</td>}
                  <td class="hideable" />
                </tr>
              );
            })}
          </tbody>
        </table>
      </div>
    ) : (
       <div class="listing">
         <!-- Grid View -->
         <div class="grid">
           {entries.map((entry) => {
             return (
               <div class="entry">
                 <a href={entry.anchor} title={entry.lastModified?.toISOString()}>
                   {isImage(entry) ? (
                     <img src={entry.anchor} alt="" loading="lazy" decoding="async" />
                   ) : <Icon {entry} />}
                   <span class="name">{
                     entry.type === 'directory' ? `${entry.name}/` : entry.name
                   }</span>
                   {entry.type === 'file' && (
                     <span class="size">{entry.humanReadableSize}</span>
                   )}
                 </a>
               </div>
             );
           })}
         </div>
       </div>
     )}
  </main>
</div>

<footer>
  Served with&nbsp;
  <a
    rel="noopener noreferrer"
    href="https://www.cloudflare.com"
    aria-label="cloudflare-logo"
  >
    <Fragment set:html={CF} />
  </a>
</footer>

<script>
  // @license magnet:?xt=urn:btih:8e4f440f4c65981c5bf93c76d35135ba5064d8b7&dn=apache-2.0.txt Apache-2.0
  const filterEl = document.querySelector<HTMLInputElement>('#filter');
  const rows = Array.from(document.querySelectorAll<HTMLTableRowElement>('tr.file'));
  const names = rows.map((row) =>
    row.querySelector('.name')?.textContent?.trim().toLowerCase() ?? ''
  );
  filterEl?.focus({ preventScroll: true });
  let previousQuery: string | undefined;

  function filter(): void {
    if (!filterEl) return;
    const query = filterEl.value.trim().toLowerCase();
    if (query === previousQuery) return;
    previousQuery = query;
    rows.forEach((row, index) => {
      const hidden = !names[index].includes(query);
      if (row.hidden !== hidden) row.hidden = hidden;
    });
  }

  filterEl?.addEventListener('keyup', filter);
  filter();

  const sizeEls = Array.from(document.querySelectorAll<HTMLElement>('.size[data-size]'));
  const largest = sizeEls.reduce(
    (max, el) => Math.max(max, Number(el.dataset.size)),
    0,
  );
  sizeEls.forEach((el) => {
    const bar = el.querySelector<HTMLElement>('.sizebar-bar');
    if (bar) {
      bar.style.width = `${
        largest ? Number(el.dataset.size) / largest * 100 : 0
      }%`;
    }
  });
  const times = document.querySelectorAll('time');
  if (times.length) {
    const formatter = new Intl.DateTimeFormat(undefined, {
      year: 'numeric',
      month: 'numeric',
      day: 'numeric',
      hour: 'numeric',
      minute: 'numeric',
      second: 'numeric',
    });
    times.forEach((el) => {
      const date = new Date(el.dateTime);
      if (!Number.isNaN(date.getTime())) el.textContent = formatter.format(date);
    });
  }
  // @license-end
</script>
